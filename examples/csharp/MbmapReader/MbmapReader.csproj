<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reference reader for consumers (e.g. a Core netstandard2.1 adapter). MbmapReader.cs uses C# 8 and
       BCL APIs available in netstandard2.1, plus System.Text.Json, which a netstandard2.1 library gets
       from the System.Text.Json NuGet package. This console project targets net8.0 so that it runs with
       no package references at all. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>8.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>MapBuilder.Reference</RootNamespace>
  </PropertyGroup>

</Project>